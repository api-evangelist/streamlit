          "id": "551e7f48-0c65-490b-98f4-4095596bf938",
          "name": "Update App Secrets",
          "request": {
            "name": "Update App Secrets",
            "description": {
              "content": "Replaces all secrets for a Streamlit application. Secrets are provided as a TOML-formatted string and are made available in the app via st.secrets. Updating secrets automatically restarts the application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "apps",
                ":appId",
                "secrets"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
